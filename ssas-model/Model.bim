          {
            "type": "calculated",
            "name": "Age",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "  DATEDIFF(dim_PolicyHolderDetails[DateOfBirth], TODAY(), YEAR)",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "AgeGroup",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              " VAR Age = DATEDIFF('dim_PolicyHolderDetails'[DateOfBirth], TODAY(), YEAR)",
              "RETURN ",
              "    SWITCH(",
              "        TRUE(),",
              "        Age <= 30, \"20-30\",",
              "        Age <= 40, \"31-40\",",
              "        Age <= 50, \"41-50\",",
              "        Age <= 60, \"51-60\",",
              "        Age <= 70, \"61-70\",",
              "        Age < 80, \"71-79\",",
              "        \"80+\"",
              "    )"
            ]
          },
          {
            "type": "calculated",
            "name": "Todos os Paises",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " \"Todos\""
          }
