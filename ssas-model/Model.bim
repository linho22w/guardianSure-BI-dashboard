          {
            "name": "Mês",
            "dataType": "int64",
            "sourceColumn": "Mês",
            "summarizeBy": "none"
          },
          {
            "name": "Nome do Mês",
            "dataType": "string",
            "sourceColumn": "Nome do Mês",
            "sortByColumn": "Mês"
          },
          {
            "name": "Trimestre",
            "dataType": "int64",
            "sourceColumn": "Trimestre",
            "summarizeBy": "none"
          },
          {
            "name": "Semana do Ano",
            "dataType": "int64",
            "sourceColumn": "Semana do Ano",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = RawPolicyDetails,",
                "    MinData = List.Min(Fonte[PolicyStartDate]),",
                "    MaxData = List.Max(Fonte[PolicyEndDate]),",
                "    ListaDatas = List.Dates(MinData, Number.From(MaxData - MinData) + 1, #duration(1,0,0,0)),",
                "    TabelaDatas = Table.FromList(ListaDatas, Splitter.SplitByNothing(), {\"Date\"}),",
                "    TabelaDatasFormatada = Table.TransformColumnTypes(TabelaDatas, { {\"Date\", type date}}),",
                "    #\"Ano Inserido\" = Table.AddColumn(TabelaDatasFormatada, \"Ano\", each Date.Year([Date]), Int64.Type),",
                "    #\"Mês Inserido\" = Table.AddColumn(#\"Ano Inserido\", \"Mês\", each Date.Month([Date]), Int64.Type),",
                "    #\"Nome do Mês Inserido\" = Table.AddColumn(#\"Mês Inserido\", \"Nome do Mês\", each Date.MonthName([Date]), type text),",
                "    #\"Trimestre Inserido\" = Table.AddColumn(#\"Nome do Mês Inserido\", \"Trimestre\", each Date.QuarterOfYear([Date]), Int64.Type),",
                "    #\"Semana do Ano Inserida\" = Table.AddColumn(#\"Trimestre Inserido\", \"Semana do Ano\", each Date.WeekOfYear([Date]), Int64.Type)",
                "",
                "in",
                "    #\"Semana do Ano Inserida\""
              ]
            }
          }
        ]
      },
